root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{c,h,sh}]
indent_style = tab
indent_size = 8

[{Makefile,Kbuild,*.mk}]
indent_style = tab
indent_size = 8

[*.{md,py,yml,yaml}]
indent_style = space
indent_size = 4

[{.clang-format,.clang-tidy,*.yml}]
indent_style = space
indent_size = 2
